# URL publique du site (liens absolus dans les e-mails, sitemap, hreflang)
NEXT_PUBLIC_SITE_URL=https://www.orentaloan.com

# --- E-mails transactionnels (Resend) ---
# Clé API Resend. Sans elle, les envois sont ignorés (journalisés), le site fonctionne.
RESEND_API_KEY=

# Expéditeur vérifié dans Resend (domaine authentifié). Ex. "OrentaLoan <no-reply@orentaloan.com>".
# Par défaut, le bac à sable Resend "onboarding@resend.dev" (n'écrit qu'au propriétaire du compte).
EMAIL_FROM="OrentaLoan <onboarding@resend.dev>"

# Boîte interne qui reçoit les notifications (nouvelle demande, contact, lead).
# Par défaut : l'e-mail de contact du pays (data/countries/*).
EMAIL_ADMIN=

# Adresse de réponse proposée au client. Par défaut : e-mail de contact du pays.
EMAIL_REPLY_TO=

# Secret de signature des liens de confirmation newsletter (double opt-in).
# Par défaut : RESEND_API_KEY, sinon une valeur de développement.
NEWSLETTER_SECRET=
